# テスト用 PostgreSQL の接続設定（サンプル）
#
# このファイルを .env にコピーしてから値を設定してください。
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# .env は gitignore 済みのため、コミットされません。
# compose.yaml は WORKLOG_TEST_PASSWORD が未設定または空の場合、
# 起動に失敗します（デフォルト値を意図的に持っていません）。

# 必須：テスト用データベースのパスワード。
# ローカル用の使い捨ての値を自由に設定してください。
WORKLOG_TEST_PASSWORD=

# 任意：未設定・空の場合は compose.yaml のデフォルト値が使われます。
# 値を変更した場合は、テストに渡す WORKLOG_TEST_CONNECTION_STRING も
# 同じ値に揃えてください（テスト側の安全ガードが照合します）。
WORKLOG_TEST_DB=worklog_test
WORKLOG_TEST_USER=worklog_user
WORKLOG_TEST_PORT=5435
